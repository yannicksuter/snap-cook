#: accounts/forms.py
msgid "Language"
msgstr "Sprache"

#: accounts/forms.py
msgid "Metric: grams and millilitres"
msgstr "Metrisch: Gramm und Milliliter"

#: accounts/forms.py
msgid "US: cups and ounces"
msgstr "US: Cups und Unzen"

#: accounts/forms.py
msgid "Units"
msgstr "Einheiten"

#: accounts/templates/accounts/not_yet.html
msgid "Not yet"
msgstr "Noch nicht"

#: accounts/templates/accounts/not_yet.html
