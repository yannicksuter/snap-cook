msgid "Saved."
msgstr "Gespeichert."

#: backoffice/templates/backoffice/_original.html
msgid "Photos or PDF"
msgstr "Fotos oder PDF"

#: backoffice/templates/backoffice/_original.html
msgid "Web page"
msgstr "Webseite"

#: backoffice/templates/backoffice/_original.html
msgid "Text"
msgstr "Text"

#: backoffice/templates/backoffice/_original.html
msgid "Link only"
msgstr "Nur Link"

#: backoffice/templates/backoffice/_original.html
msgid "No original kept"
msgstr "Kein Original gespeichert"

#: backoffice/templates/backoffice/archive.html
msgid ""
"Recipes of deleted accounts. No one sees them until you give them to someone."
msgstr ""
"Rezepte gelöschter Konten. Niemand sieht sie, bis du sie jemandem gibst."

#: backoffice/templates/backoffice/archive.html
msgid "Give to"
msgstr "Geben an"

#: backoffice/templates/backoffice/archive.html
msgid "Give to…"
msgstr "Geben an …"

#: backoffice/templates/backoffice/archive.html
msgid "Give"
msgstr "Geben"

#: backoffice/templates/backoffice/archive.html
msgid "Nothing in the archive."
msgstr "Das Archiv ist leer."

#: backoffice/templates/backoffice/base.html
msgid "People"
msgstr "Personen"

#: backoffice/templates/backoffice/base.html
msgid "Archive"
msgstr "Archiv"

#: backoffice/templates/backoffice/people.html
msgctxt "role"
msgid "Admin"
msgstr "Admin"

#: backoffice/templates/backoffice/people.html
msgid "Not confirmed yet"
msgstr "Noch nicht bestätigt"

#: backoffice/templates/backoffice/people.html
msgid "Email and password"
msgstr "E-Mail und Passwort"

#: backoffice/templates/backoffice/people.html
#: recipes/templates/recipes/index.html
#, python-format
msgid "%(counter)s recipe"
msgid_plural "%(counter)s recipes"
msgstr[0] "%(counter)s Rezept"
msgstr[1] "%(counter)s Rezepte"

#: backoffice/templates/backoffice/people.html
#, python-format
msgid "Last signed in %(when)s"
msgstr "Zuletzt angemeldet %(when)s"

#: backoffice/templates/backoffice/people.html
msgid "Never signed in"
msgstr "Nie angemeldet"

#: backoffice/templates/backoffice/people.html
msgid "May cook"
msgstr "Darf kochen"

#: backoffice/templates/backoffice/people.html
#: imports/templates/imports/_progress.html
msgid "Delete"
msgstr "Löschen"

#: backoffice/templates/backoffice/people.html
#, python-format
msgid ""
"%(initials)s can no longer sign in. Their recipes go to the archive, where "
"you can give them to someone else."
msgstr ""
"%(initials)s kann sich nicht mehr anmelden. Die Rezepte kommen ins Archiv, "
"wo du sie jemand anderem geben kannst."

#: backoffice/templates/backoffice/people.html
#, python-format
msgid "Yes, delete %(initials)s"
msgstr "Ja, %(initials)s löschen"

#: backoffice/templates/backoffice/people.html
msgid "No one has an account yet."
msgstr "Noch niemand hat ein Konto."

#: backoffice/templates/backoffice/recipes.html
msgid "Shared"
msgstr "Geteilt"

#: backoffice/templates/backoffice/recipes.html
msgid "Private"
msgstr "Privat"

#: backoffice/templates/backoffice/recipes.html
msgid "Read again"
msgstr "Neu einlesen"

#: backoffice/templates/backoffice/recipes.html
#: recipes/templates/recipes/index.html
msgid "No recipes yet."
msgstr "Noch keine Rezepte."

#: backoffice/views.py
msgid "You cannot delete yourself."
msgstr "Dich selbst kannst du nicht löschen."

#: backoffice/views.py
#, python-format
msgid "%(initials)s was deleted."
msgstr "%(initials)s wurde gelöscht."

#: backoffice/views.py
msgid "Nothing of this recipe’s original was kept."
msgstr "Vom Original dieses Rezepts ist nichts gespeichert."

#: backoffice/views.py
#, python-format
msgid "“%(title)s” belongs to %(initials)s now."
msgstr "„%(title)s“ gehört jetzt %(initials)s."

#: imports/forms.py
msgid "Link to a recipe"
msgstr "Link zu einem Rezept"

#: imports/forms.py imports/templates/imports/add.html
msgid "Recipe text"
msgstr "Rezepttext"

#: imports/forms.py
msgid ""
"That is more text than one recipe needs. Copy only the part with the recipe."
msgstr ""
"Das ist mehr Text, als ein Rezept braucht. Kopiere nur den Teil mit dem "
"Rezept."

#: imports/forms.py
msgid "Photos"
msgstr "Fotos"

#: imports/forms.py
msgid "Choose at least one photo."
msgstr "Wähle mindestens ein Foto."

#: imports/forms.py
#, python-format
msgid "At most %(count)s photos at once."
msgstr "Höchstens %(count)s Fotos auf einmal."

#: imports/forms.py
msgid ""
"This is an iPhone HEIC photo. Choose it from the photo picker, which sends a "
"JPEG, or set the camera to “Most Compatible”."
msgstr ""
"Das ist ein HEIC-Foto vom iPhone. Wähle es über die Fotoauswahl, die ein "
"JPEG sendet, oder stelle die Kamera auf „Maximale Kompatibilität“."

#: imports/forms.py
msgid "Use a photo (JPEG, PNG, WebP, GIF) or a PDF."
msgstr "Verwende ein Foto (JPEG, PNG, WebP, GIF) oder ein PDF."

#: imports/forms.py
#, python-format
msgid "A PDF can be at most %(size)s MB."
msgstr "Ein PDF darf höchstens %(size)s MB haben."

#: imports/forms.py
#, python-format
msgid "Each photo can be at most %(size)s MB."
msgstr "Jedes Foto darf höchstens %(size)s MB haben."

#: imports/forms.py
#, python-format
msgid "Together the files can be at most %(size)s MB."
msgstr "Zusammen dürfen die Dateien höchstens %(size)s MB haben."

#: imports/forms.py
msgid "Name"
msgstr "Name"

#: imports/forms.py
msgid "Short description"
msgstr "Kurze Beschreibung"

#: imports/forms.py
msgid "Serves"
msgstr "Portionen"

#: imports/templates/imports/_progress.html
#: imports/templates/imports/status.html
msgid "Reading your recipe…"
msgstr "Dein Rezept wird gelesen…"

#: imports/templates/imports/_progress.html
msgid "Photos received"
msgstr "Fotos erhalten"

#: imports/templates/imports/_progress.html
msgid "Link received"
msgstr "Link erhalten"

#: imports/templates/imports/_progress.html
msgid "Text received"
msgstr "Text erhalten"

#: imports/templates/imports/_progress.html
msgid "Finding the ingredients and steps"
msgstr "Zutaten und Schritte werden gesucht"

#: imports/templates/imports/_progress.html
msgid "Ready for you to check"
msgstr "Bereit zum Prüfen"

#: imports/templates/imports/_progress.html
msgid ""
"This usually takes under a minute. You can leave this page: the draft waits "
"for you on Home."
msgstr ""
"Das dauert meist weniger als eine Minute. Du kannst die Seite verlassen: Der "
"Entwurf wartet auf der Startseite auf dich."

#: imports/templates/imports/_progress.html
msgid "That did not work"
msgstr "Das hat nicht geklappt"

#: imports/templates/imports/_progress.html
msgid "Look at what was read"
msgstr "Ansehen, was gelesen wurde"

#: imports/templates/imports/_progress.html
#: translations/templates/translations/_progress.html
msgid "Try again"
msgstr "Nochmals versuchen"

#: imports/templates/imports/_recipe_form.html
#: recipes/templates/recipes/_render.html
msgid "Ingredients"
msgstr "Zutaten"

#: imports/templates/imports/_recipe_form.html
#: recipes/templates/recipes/_render.html
msgid "optional"
msgstr "optional"

#: imports/templates/imports/_recipe_form.html
#: recipes/templates/recipes/_render.html
msgid "Steps"
msgstr "Schritte"

#: imports/templates/imports/_recipe_form.html
msgid "Edit the recipe text"
msgstr "Rezepttext bearbeiten"

#: imports/templates/imports/_recipe_form.html
msgid ""
"One step per paragraph. Ingredients, times and temperatures are marked like "
"this:"
msgstr ""
"Ein Schritt pro Absatz. Zutaten, Zeiten und Temperaturen werden so markiert:"

#: imports/templates/imports/add.html recipes/templates/recipes/index.html
msgid "Add a recipe"
msgstr "Rezept hinzufügen"

#: imports/templates/imports/add.html imports/views.py
msgid "Reading recipes is not set up on this server yet."
msgstr ""
"Das Einlesen von Rezepten ist auf diesem Server noch nicht eingerichtet."

#: imports/templates/imports/add.html
msgid ""
"Set SNAPCOOK_LLM_API_KEY on the worker container; docs/install.md says how."
msgstr ""
"Setze SNAPCOOK_LLM_API_KEY im Worker-Container; wie das geht, steht in docs/"
"install.md."

#: imports/templates/imports/add.html
msgid ""
"snap-cook picks out the ingredients and the steps, and leaves everything "
"else out."
msgstr ""
"snap-cook sucht die Zutaten und die Schritte heraus und lässt alles andere "
"weg."

#. Translators: the Ctrl key as keyboards print it. German keyboards say “Strg”, Swiss ones “Ctrl”.
#: imports/templates/imports/add.html
msgctxt "keyboard key"
msgid "Ctrl"
msgstr "Ctrl"

#: imports/templates/imports/add.html
msgid "Paste a page copied from a website or a PDF"
msgstr "Eine kopierte Webseite oder PDF-Seite einfügen"

#: imports/templates/imports/add.html
msgid "Or drop a PDF or a photo onto this page"
msgstr "Oder ein PDF oder Foto auf diese Seite ziehen"

#: imports/templates/imports/add.html
msgid "Take a photo"
msgstr "Foto aufnehmen"

#: imports/templates/imports/add.html
msgid "Of a cookbook page or a handwritten card"
msgstr "Von einer Kochbuchseite oder einer handgeschriebenen Karte"

#: imports/templates/imports/add.html
msgid "Read the photo"
msgstr "Foto einlesen"

#: imports/templates/imports/add.html
msgid "Or paste a link"
msgstr "Oder einen Link einfügen"

#: imports/templates/imports/add.html
msgid "Get the recipe"
msgstr "Rezept holen"

#: imports/templates/imports/add.html
msgid "Choose photos or a PDF"
msgstr "Fotos oder ein PDF wählen"

#: imports/templates/imports/add.html
msgid "Screenshots and web pages saved as PDF too, several at once"
msgstr ""
"Auch Screenshots und als PDF gespeicherte Webseiten, mehrere auf einmal"

#: imports/templates/imports/add.html
msgid "Read the photos"
msgstr "Fotos einlesen"

#: imports/templates/imports/add.html
msgid "Paste text"
msgstr "Text einfügen"

#: imports/templates/imports/add.html
msgid "A whole web page or PDF you copied, an email or a message"
msgstr ""
"Eine ganze kopierte Webseite oder ein PDF, eine E-Mail oder eine Nachricht"

#: imports/templates/imports/add.html
msgid "Read the text"
msgstr "Text einlesen"

#: imports/templates/imports/add.html
msgid "New recipes stay private until you share them."
msgstr "Neue Rezepte bleiben privat, bis du sie teilst."

#: imports/templates/imports/add.html
msgid "Drop it here to read it"
msgstr "Hier loslassen zum Einlesen"

#: imports/templates/imports/add.html
msgid "Sending…"
msgstr "Wird gesendet…"

#: imports/templates/imports/review.html
msgid "Check the recipe"
msgstr "Rezept prüfen"

#: imports/templates/imports/review.html recipes/templates/recipes/_chart.html
msgid "Close"
msgstr "Schliessen"

#: imports/templates/imports/review.html
msgid "Draft, only you"
msgstr "Entwurf, nur für dich"

#: imports/templates/imports/review.html
msgid ""
"Read again from its original. Saving makes this the recipe’s new version; "
"the one before is kept."
msgstr ""
"Neu eingelesen aus dem Original. Speichern macht dies zur neuen Fassung des "
"Rezepts; die bisherige bleibt erhalten."

#: imports/templates/imports/review.html
msgid "Change anything that looks wrong, then save."
msgstr "Ändere, was nicht stimmt, und speichere dann."

#: imports/templates/imports/review.html
msgid "Left out:"
msgstr "Weggelassen:"

#: imports/templates/imports/review.html
msgid "From:"
msgstr "Quelle:"

#: imports/templates/imports/review.html
#, python-format
msgid ""
"A step uses “%(name)s”, but no step makes it. Check the recipe text below."
msgstr ""
"Ein Schritt verwendet „%(name)s“, aber kein Schritt stellt es her. Prüfe den "
"Rezepttext unten."

#: imports/templates/imports/review.html
msgid "Keep it as it is"
msgstr "So lassen"

#: imports/templates/imports/review.html
msgid "Save as new version"
msgstr "Als neue Fassung speichern"

#: imports/templates/imports/review.html
msgid "Save recipe"
msgstr "Rezept speichern"

#: imports/templates/imports/review.html recipes/templates/recipes/edit.html
msgid "Update the preview"
msgstr "Vorschau aktualisieren"

#: imports/templates/imports/review.html
msgid "Delete this draft"
msgstr "Diesen Entwurf löschen"

#: imports/views.py
msgid "That link leads into a private network, so it cannot be read."
msgstr ""
"Dieser Link führt in ein privates Netzwerk und kann deshalb nicht gelesen "
"werden."

#: imports/views.py
msgid ""
"The page could not be loaded. Check the link, or paste the recipe’s text "
"instead."
msgstr ""
"Die Seite konnte nicht geladen werden. Prüfe den Link oder füge stattdessen "
"den Text des Rezepts ein."

#: imports/views.py
msgid "The page is too large to read."
msgstr "Die Seite ist zu umfangreich zum Lesen."

#: imports/views.py
msgid "No recipe was found in it."
msgstr "Darin wurde kein Rezept gefunden."

#: imports/views.py
msgid "The recipe came back in a form that could not be read."
msgstr "Das Rezept kam in einer Form zurück, die nicht gelesen werden konnte."

#: imports/views.py
msgid "The reader declined this one."
msgstr "Das Einlesen wurde für diese Quelle abgelehnt."

#: imports/views.py
msgid "The reading service is busy. Try again in a minute."
msgstr "Der Lesedienst ist ausgelastet. Versuche es in einer Minute nochmals."

#: imports/views.py
msgid "Reading failed. Try again in a moment."
msgstr "Das Einlesen ist fehlgeschlagen. Versuche es gleich nochmals."

#: imports/views.py
msgid "Reading took too long and was stopped."
msgstr "Das Einlesen hat zu lange gedauert und wurde abgebrochen."

#: imports/views.py
msgid ""
"Nothing of the original was kept, and its link no longer loads, so it cannot "
"be read again."
msgstr ""
"Vom Original ist nichts gespeichert, und der Link lädt nicht mehr. Darum "
"lässt es sich nicht neu einlesen."

#: imports/views.py
msgid "The draft was deleted."
msgstr "Der Entwurf wurde gelöscht."

#: imports/views.py
msgid "That answer no longer fits the text. Edit the text instead."
msgstr ""
"Diese Antwort passt nicht mehr zum Text. Bearbeite stattdessen den Text."

#: imports/views.py
msgid "Saved. Only you can see this recipe."
msgstr "Gespeichert. Nur du siehst dieses Rezept."

#: imports/views.py
msgid "That recipe was deleted meanwhile, so nothing was saved."
msgstr "Das Rezept wurde inzwischen gelöscht, darum wurde nichts gespeichert."

#: imports/views.py
#, python-format
msgid "Saved as a new version of “%(title)s”."
msgstr "Als neue Fassung von „%(title)s“ gespeichert."

#: recipes/templates/recipes/_chart.html
msgid "Zoom out"
msgstr "Verkleinern"

#: recipes/templates/recipes/_chart.html
msgid "Zoom in"
msgstr "Vergrössern"

#: recipes/templates/recipes/_chart.html
msgid "Fit"
msgstr "Einpassen"

#: recipes/templates/recipes/_facts.html
msgid "Takes at least"
msgstr "Dauert mindestens"

#: recipes/templates/recipes/_facts.html
msgid "Ready in"
msgstr "Fertig in"

#: recipes/templates/recipes/_facts.html
msgid "Hands-on"
msgstr "Arbeitszeit"

#: recipes/templates/recipes/_facts.html
msgid "Cooking"
msgstr "Back-/Kochzeit"

#: recipes/templates/recipes/_facts.html
msgid "Resting"
msgstr "Ruhezeit"

#: recipes/templates/recipes/_render.html
msgid "Fewer servings"
msgstr "Weniger Portionen"

#: recipes/templates/recipes/_render.html
msgid "Less"
msgstr "Weniger"

#: recipes/templates/recipes/_render.html
#, python-format
msgid "%(counter)s serving"
msgid_plural "%(counter)s servings"
msgstr[0] "%(counter)s Portion"
msgstr[1] "%(counter)s Portionen"

#: recipes/templates/recipes/_render.html
msgid "More servings"
msgstr "Mehr Portionen"

#: recipes/templates/recipes/_render.html
msgid "More"
msgstr "Mehr"

#: recipes/templates/recipes/_render.html
msgid "Not recognised: please check this ingredient"
msgstr "Nicht erkannt: Bitte diese Zutat prüfen"

#: recipes/templates/recipes/_render.html
msgid "Save time:"
msgstr "Zeit sparen:"

#: recipes/templates/recipes/_render.html
#, python-format
msgid "Step %(number)s:"
msgstr "Schritt %(number)s:"

#: recipes/templates/recipes/_render.html
msgid "At a glance"
msgstr "Auf einen Blick"

#: recipes/templates/recipes/_render.html
msgid "Full screen"
msgstr "Vollbild"

#: recipes/templates/recipes/_render.html recipes/templates/recipes/chart.html
msgid "Print"
msgstr "Drucken"

#: recipes/templates/recipes/_render.html
msgid ""
"The recipe as a chart: the ingredients in green go into the numbered steps, "
"and the dark green shape at the end is the finished dish."
msgstr ""
"Das Rezept als Diagramm: Die Zutaten in Grün gehen in die nummerierten "
"Schritte, und die dunkelgrüne Form am Ende ist das fertige Gericht."

#: recipes/templates/recipes/base.html
msgid "Your settings: language and units"
msgstr "Deine Einstellungen: Sprache und Einheiten"

#: recipes/templates/recipes/base.html templates/account/login.html
msgid "Sign in"
msgstr "Anmelden"

#: recipes/templates/recipes/chart.html recipes/templates/recipes/edit.html
msgid "Back to the recipe"
msgstr "Zurück zum Rezept"

#: recipes/templates/recipes/chart.html
#, python-format
msgid "for %(counter)s serving"
msgid_plural "for %(counter)s servings"
msgstr[0] "für %(counter)s Portion"
msgstr[1] "für %(counter)s Portionen"

#: recipes/templates/recipes/detail.html
msgid "Edit"
msgstr "Bearbeiten"

#: recipes/templates/recipes/edit.html
msgid "Edit recipe"
msgstr "Rezept bearbeiten"

#: recipes/templates/recipes/edit.html
msgid ""
"Saving keeps the earlier version, and translations of what you did not "
"change."
msgstr ""
"Beim Speichern bleibt die frühere Fassung erhalten, ebenso die Übersetzungen "
"von allem, was du nicht änderst."

#: recipes/templates/recipes/edit.html
msgid "Delete recipe"
msgstr "Rezept löschen"

#: recipes/templates/recipes/edit.html
#, python-format
msgid ""
"“%(title)s” disappears from your recipes, and for everyone you shared it "
"with."
msgstr ""
"„%(title)s“ verschwindet aus deinen Rezepten und bei allen, mit denen du es "
"geteilt hast."

#: recipes/templates/recipes/edit.html
msgid "Yes, delete it"
msgstr "Ja, löschen"

#: recipes/templates/recipes/index.html
msgid "Search recipes"
msgstr "Rezepte suchen"

#: recipes/templates/recipes/index.html
msgid "Search by name or ingredient"
msgstr "Nach Name oder Zutat suchen"

#: recipes/templates/recipes/index.html
msgid "Search"
msgstr "Suchen"

#: recipes/templates/recipes/index.html
msgid "Waiting for you"
msgstr "Wartet auf dich"

#: recipes/templates/recipes/index.html
msgid "New recipe"
msgstr "Neues Rezept"

#: recipes/templates/recipes/index.html
msgid "Ready to check"
msgstr "Bereit zum Prüfen"

#: recipes/templates/recipes/index.html
msgid "Could not be read"
msgstr "Konnte nicht gelesen werden"

#: recipes/templates/recipes/index.html
msgid "Reading…"
msgstr "Wird gelesen…"

#: recipes/templates/recipes/index.html
msgid "Only you can see this"
msgstr "Nur du kannst das sehen"

#: recipes/templates/recipes/index.html
msgid "Anyone with the link can see this"
msgstr "Alle mit dem Link können das sehen"

#: recipes/templates/recipes/index.html
#, python-format
msgid "No recipe matches “%(query)s”."
msgstr "Kein Rezept passt zu „%(query)s“."

#: recipes/templates/recipes/index.html
msgid "Show all recipes"
msgstr "Alle Rezepte anzeigen"

#: recipes/templates/recipes/index.html
msgid "Recipes appear here as soon as they are added."
msgstr "Rezepte erscheinen hier, sobald sie hinzugefügt sind."

#: recipes/templatetags/recipe_extras.py
#, python-format
msgid ""
"Steps %(first)s and %(last)s don’t depend on each other, so you can do them "
"side by side."
msgstr ""
"Die Schritte %(first)s und %(last)s hängen nicht voneinander ab, du kannst "
"sie also gleichzeitig erledigen."

#: recipes/templatetags/recipe_extras.py
#, python-format
msgid ""
"Steps %(first)s to %(last)s don’t depend on each other, so you can do them "
"side by side."
msgstr ""
"Die Schritte %(first)s bis %(last)s hängen nicht voneinander ab, du kannst "
"sie also gleichzeitig erledigen."

#: recipes/templatetags/recipe_extras.py
#, python-format
msgid "Uses what you made in step %(number)s."
msgstr "Verwendet, was du in Schritt %(number)s zubereitet hast."

#: recipes/templatetags/recipe_extras.py
#, python-format
msgid "%(list)s and %(last)s"
msgstr "%(list)s und %(last)s"

#: recipes/templatetags/recipe_extras.py
#, python-format
msgid "Uses what you made in steps %(numbers)s."
msgstr "Verwendet, was du in den Schritten %(numbers)s zubereitet hast."

#: recipes/views.py
msgid ""
"Times and oven temperatures stay as in the recipe. Check them when you cook "
"more or less."
msgstr ""
"Zeiten und Ofentemperaturen bleiben wie im Rezept. Prüfe sie, wenn du mehr "
"oder weniger kochst."

#: recipes/views.py
msgid ""
"Some amounts cannot be shown in cups and ounces, so they stay as in the "
"recipe."
msgstr ""
"Manche Mengen lassen sich nicht in Cups und Unzen zeigen und bleiben wie im "
"Rezept."

#: recipes/views.py
#, python-format
msgid "This text cannot be read: %(detail)s"
msgstr "Dieser Text lässt sich nicht lesen: %(detail)s"

#: recipes/views.py
#, python-format
msgid "“%(title)s” was deleted."
msgstr "„%(title)s“ wurde gelöscht."

#: templates/account/_google.html
msgid "Continue with Google"
msgstr "Weiter mit Google"

#: templates/account/login.html
msgid ""
"Anyone can read the recipes. Sign in to keep your settings, and to add "
"recipes of your own."
msgstr ""
"Die Rezepte kann jede und jeder lesen. Melde dich an, um deine Einstellungen "
"zu behalten und eigene Rezepte hinzuzufügen."

#: templates/account/login.html templates/account/signup.html
msgid "or with your email"
msgstr "oder mit deiner E-Mail"

#: templates/account/login.html templates/account/signup.html
msgid "Email"
msgstr "E-Mail"

#: templates/account/login.html templates/account/signup.html
msgid "Password"
msgstr "Passwort"

#: templates/account/login.html
msgid "Forgot your password?"
msgstr "Passwort vergessen?"

#: templates/account/login.html templates/account/signup.html
msgid "Create an account"
msgstr "Konto erstellen"

#: templates/account/messages/email_confirmation_failed.txt
msgid "That address is already confirmed by another account."
msgstr "Diese Adresse ist schon bei einem anderen Konto bestätigt."

#: templates/account/messages/email_confirmation_sent.txt
msgid "We sent you a link to confirm your email."
msgstr "Wir haben dir einen Link geschickt, um deine E-Mail zu bestätigen."

#: templates/account/messages/email_confirmed.txt
msgid "Your email is confirmed."
msgstr "Deine E-Mail ist bestätigt."

#: templates/account/signup.html
msgid ""
"We send you a link to confirm your email. Your address is never shown to "
"anyone; you appear by your initials."
msgstr ""
"Wir schicken dir einen Link, um deine E-Mail zu bestätigen. Deine Adresse "
"sieht niemand; du erscheinst mit deinen Initialen."

#: templates/account/signup.html
msgid "At least 12 characters, and not a common one."
msgstr "Mindestens 12 Zeichen, und kein gängiges."

#: templates/account/signup.html
msgid "Password again"
msgstr "Passwort nochmals"

#: templates/account/signup.html
msgid "I already have an account"
msgstr "Ich habe schon ein Konto"

#: translations/templates/translations/_progress.html
msgid ""
"Translating this recipe. It changes by itself when it is done, usually "
"within a minute."
msgstr ""
"Das Rezept wird übersetzt. Es wechselt von selbst, sobald es fertig ist, "
"meist innerhalb einer Minute."

#: translations/templates/translations/_progress.html
msgid "This recipe could not be translated, so it is shown as written."
msgstr ""
"Das Rezept konnte nicht übersetzt werden und wird deshalb so gezeigt, wie es "
"geschrieben ist."

#: translations/templates/translations/_progress.html
msgid ""
"Translating is not set up on this server, so most of this recipe is shown as "
"written."
msgstr ""
"Übersetzen ist auf diesem Server nicht eingerichtet, deshalb steht das "
"meiste so da, wie es geschrieben ist."
