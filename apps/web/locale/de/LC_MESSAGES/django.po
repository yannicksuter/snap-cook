#: recipes/templatetags/recipe_extras.py:27
#, python-format
msgid ""
"Steps %(first)s and %(last)s don’t depend on each other, so you can do them "
"side by side."
msgstr ""
"Die Schritte %(first)s und %(last)s hängen nicht voneinander ab, du kannst "
"sie also gleichzeitig erledigen."

#: recipes/templatetags/recipe_extras.py:31
#, python-format
msgid ""
"Steps %(first)s to %(last)s don’t depend on each other, so you can do them "
"side by side."
msgstr ""
"Die Schritte %(first)s bis %(last)s hängen nicht voneinander ab, du kannst "
"sie also gleichzeitig erledigen."

#: recipes/templatetags/recipe_extras.py:47
#, python-format
msgid "Uses what you made in step %(number)s."
msgstr "Verwendet, was du in Schritt %(number)s zubereitet hast."

#: recipes/templatetags/recipe_extras.py:48
#, python-format
msgid "%(list)s and %(last)s"
msgstr "%(list)s und %(last)s"

#: recipes/templatetags/recipe_extras.py:52
#, python-format
msgid "Uses what you made in steps %(numbers)s."
msgstr "Verwendet, was du in den Schritten %(numbers)s zubereitet hast."

#: recipes/views.py:138
msgid ""
"Times and oven temperatures stay as in the recipe. Check them when you cook "
"more or less."
msgstr ""
"Zeiten und Ofentemperaturen bleiben wie im Rezept. Prüfe sie, wenn du mehr "
"oder weniger kochst."

#: recipes/views.py:144
msgid ""
"Some amounts cannot be shown in cups and ounces, so they stay as in the "
"recipe."
msgstr ""
"Manche Mengen lassen sich nicht in Cups und Unzen zeigen und bleiben wie im "
"Rezept."

#: recipes/views.py:225
#, python-format
msgid "This text cannot be read: %(detail)s"
msgstr "Dieser Text lässt sich nicht lesen: %(detail)s"

#: recipes/views.py:251
#, python-format
msgid "“%(title)s” was deleted."
msgstr "„%(title)s“ wurde gelöscht."

#: recipes/views.py:264
#, python-format
msgid "by %(initials)s"
msgstr "von %(initials)s"

#: templates/account/_google.html:14
msgid "Continue with Google"
msgstr "Weiter mit Google"

#: templates/account/login.html:16
msgid ""
"Anyone can read the recipes. Sign in to keep your settings, and to add "
"recipes of your own."
msgstr ""
"Die Rezepte kann jede und jeder lesen. Melde dich an, um deine Einstellungen"
" zu behalten und eigene Rezepte hinzuzufügen."

#: templates/account/login.html:22 templates/account/signup.html:21
msgid "or with your email"
msgstr "oder mit deiner E-Mail"

#: templates/account/login.html:27 templates/account/login.html:28
#: templates/account/signup.html:26
msgid "Email"
msgstr "E-Mail"

#: templates/account/login.html:31 templates/account/login.html:32
#: templates/account/signup.html:30
msgid "Password"
msgstr "Passwort"

#: templates/account/login.html:39
msgid "Forgot your password?"
msgstr "Passwort vergessen?"

#: templates/account/login.html:40 templates/account/signup.html:11
#: templates/account/signup.html:15 templates/account/signup.html:40
msgid "Create an account"
msgstr "Konto erstellen"

#: templates/account/messages/email_confirmation_failed.txt:1
msgid "That address is already confirmed by another account."
msgstr "Diese Adresse ist schon bei einem anderen Konto bestätigt."

#: templates/account/messages/email_confirmation_sent.txt:1
msgid "We sent you a link to confirm your email."
msgstr "Wir haben dir einen Link geschickt, um deine E-Mail zu bestätigen."

#: templates/account/messages/email_confirmed.txt:1
msgid "Your email is confirmed."
msgstr "Deine E-Mail ist bestätigt."

#: templates/account/signup.html:16
msgid ""
"We send you a link to confirm your email. Your address is never shown to "
"anyone; you appear by your initials."
msgstr ""
"Wir schicken dir einen Link, um deine E-Mail zu bestätigen. Deine Adresse "
"sieht niemand; du erscheinst mit deinen Initialen."

#: templates/account/signup.html:33
msgid "At least 12 characters, and not a common one."
msgstr "Mindestens 12 Zeichen, und kein gängiges."

#: templates/account/signup.html:35
msgid "Password again"
msgstr "Passwort nochmals"

#: templates/account/signup.html:43
msgid "I already have an account"
msgstr "Ich habe schon ein Konto"

#: translations/templates/translations/_progress.html:12
msgid ""
"Translating this recipe. It changes by itself when it is done, usually "
"within a minute."
msgstr ""
"Das Rezept wird übersetzt. Es wechselt von selbst, sobald es fertig ist, "
"meist innerhalb einer Minute."

#: translations/templates/translations/_progress.html:16
msgid "This recipe could not be translated, so it is shown as written."
msgstr ""
"Das Rezept konnte nicht übersetzt werden und wird deshalb so gezeigt, wie es"
" geschrieben ist."

#: translations/templates/translations/_progress.html:24
msgid ""
"Translating is not set up on this server, so most of this recipe is shown as"
" written."
msgstr ""
"Übersetzen ist auf diesem Server nicht eingerichtet, deshalb steht das "
"meiste so da, wie es geschrieben ist."
