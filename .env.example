# snap-cook environment.
#
# Copy to .env and fill in. PLACEHOLDERS ONLY in this file -- it is committed to a
# public repository. Never put a real secret here.
#
# This file must stay in sync with the docstring at the top of
# apps/web/snapcookweb/settings.py, which is the authoritative list.

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
# Every host the app is reached by must be listed or Django returns 400 DisallowedHost.
#   dev:  127.0.0.1,localhost
#   prod: cook.example.com,192.168.1.42,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------- Database
# Postgres is a DERIVED PROJECTION. It is rebuildable from /data/store via
# `manage.py reindex --full`. Losing it costs social data only.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=snapcook
POSTGRES_USER=snapcook
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- Storage
# The authoritative recipe store. THIS is what must be backed up.
SNAPCOOK_DATA_DIR=/data

# ---------------------------------------------------------------- Google SSO
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# Google will NOT accept a private LAN IP as a redirect URI -- see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Product API
SNAPCOOK_API_ENABLED=1
# Server-side pepper mixed into the hash of every user Personal Access Token.
# Rotating this invalidates every issued PAT.
SNAPCOOK_API_TOKEN_PEPPER=

# ---------------------------------------------------------------- Ops API
# DANGER: the ops API bypasses per-user scoping. /ops/api/versions/{hash} can dump
# ANY user's private recipe. Do not route /ops/api/ through a public tunnel --
# keep it LAN-only or behind a VPN. See docs/reference/api-ops.md.
SNAPCOOK_OPS_API_ENABLED=0
# Must be >=32 chars. The app refuses to boot if ops is enabled and this is weak.
SNAPCOOK_OPS_API_TOKEN=
SNAPCOOK_OPS_API_WRITE=0

# ---------------------------------------------------------------- LLM import
SNAPCOOK_LLM_PROVIDER=anthropic
SNAPCOOK_LLM_API_KEY=
# Set when pointing at a self-hosted inference service (see services/llm/).
SNAPCOOK_LLM_BASE_URL=

# ---------------------------------------------------------------- Seed data
# Opt in to share-alike (ODbL) ingredient sources. Default 0 keeps the shipped
# dataset free of copyleft obligations. See THIRD_PARTY_DATA.md.
SNAPCOOK_ALLOW_SHARE_ALIKE_DATA=0
